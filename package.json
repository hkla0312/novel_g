{
  "name": "akano-yume-vertical-slice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner --exclude src/simulation/report.test.ts",
    "validate": "vitest run --configLoader runner src/scenario/scenario.test.ts",
    "simulate": "vitest run --configLoader runner src/simulation/report.test.ts",
    "report:human": "node scripts/aggregate-human-playtests.mjs",
    "preview": "vite preview --configLoader runner --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "7.3.6",
    "vitest": "^3.2.4"
  }
}

